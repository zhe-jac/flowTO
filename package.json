{
  "name": "toronto-traffic-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/lib/traffic/*.test.ts",
    "data:build": "tsx scripts/build-roads.ts",
    "data:boundary": "tsx scripts/build-city-boundary.ts && tsx scripts/build-city-fade.ts",
    "data:traffic": "tsx scripts/build-traffic.ts",
    "data:traffic-topology": "tsx scripts/build-traffic-topology.ts",
    "data:events": "tsx scripts/fetch-venue-events.ts",
    "data:traffic-geometry": "tsx scripts/refresh-traffic-geometry.ts"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@loaders.gl/core": "4.5.2",
    "@loaders.gl/mvt": "4.5.2",
    "liquid-glass-react": "^1.1.1",
    "mapbox-gl": "^3.33.0",
    "maplibre-gl": "^6.14.0",
    "motion": "13.4.6",
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@turf/buffer": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/shapefile": "^0.6.4",
    "@types/three": "^0.186.0",
    "fflate": "^0.8.3",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
