NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_public_mapbox_token
# Server-only: never use a NEXT_PUBLIC_ prefix for the Gemini key.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# Optional, server-only: Tiger Data (Timescale Postgres) connection string for saving and comparing scenario runs.
# Example: postgres://tsdbadmin:password@host.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
TIGER_DATABASE_URL=
